{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bsc.com.vn/schemas/quant-report.schema.json",
  "title": "BSC Quant Strategic Report",
  "type": "object",
  "required": ["meta", "topbar", "hero", "recTable", "chart", "heatmap", "stockCards"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["docCode", "reportTitle", "pageCount"],
      "properties": {
        "docCode": { "type": "string", "pattern": "^BSC-QUANT-[0-9]{4}-[0-9]{2}$" },
        "reportTitle": { "type": "string", "minLength": 1 },
        "pageCount": { "type": "integer", "minimum": 1 }
      }
    },
    "recTable": {
      "type": "object",
      "required": ["rows"],
      "properties": {
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["ticker", "sector", "buyPrice", "peTtm", "pbTtm", "profitGrowth", "weight"],
            "properties": {
              "ticker": { "type": "string", "minLength": 1 },
              "weight": { "type": "number", "minimum": 0, "maximum": 100 }
            }
          }
        }
      }
    },
    "stockCards": {
      "type": "array",
      "items": { "type": "object", "required": ["ticker", "weight", "metrics"] }
    }
  }
}
