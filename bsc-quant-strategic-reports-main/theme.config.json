{
  "_comment": "BSC Quant Research — Design Token System. Sửa file này để thay đổi toàn bộ visual của report.",
  "brand": {
    "name": "BSC Securities",
    "nameShort": "BSC",
    "division": "Quant Research",
    "website": "https://www.bsc.com.vn",
    "logoPath": "../assets/img/logo.png"
  },
  "colors": {
    "_comment": "Semantic color roles — mỗi màu gắn 1 vai trò cố định",
    "bscBlue":       "#295CA9",
    "bscTeal":       "#009B87",
    "bscGold":       "#FFC132",
    "positive":      "#16A34A",
    "negative":      "#DC2626",
    "neutral":       "#64748B",
    "textPrimary":   "#334155",
    "textSecondary": "#475569",
    "textTertiary":  "#64748B",
    "bgCanvas":      "#F1F5F9",
    "surface":       "#F8FAFC",
    "card":          "#FFFFFF",
    "tintBlue":      "#EEF4FC",
    "tintTeal":      "#E6F5F3",
    "line":          "#E2E8F0"
  },
  "typeScale": {
    "_comment": "Major Second ratio ~1.125. Hard floor = 12px — không vi phạm bất kỳ đâu kể cả @media print",
    "display": { "size": "38px", "weight": 700, "lineHeight": 1.1,  "usage": "Hero numbers, index targets" },
    "h1":      { "size": "28px", "weight": 700, "lineHeight": 1.25, "usage": "Report title" },
    "h2":      { "size": "22px", "weight": 600, "lineHeight": 1.3,  "usage": "Section headings" },
    "h3":      { "size": "18px", "weight": 600, "lineHeight": 1.35, "usage": "Sub-section headings" },
    "h4":      { "size": "16px", "weight": 500, "lineHeight": 1.4,  "usage": "Card headings, ticker names" },
    "bodyLg":  { "size": "15px", "weight": 400, "lineHeight": 1.6,  "usage": "Lede paragraph, key rec text" },
    "body":    { "size": "14px", "weight": 400, "lineHeight": 1.55, "usage": "Table data, main content" },
    "label":   { "size": "12px", "weight": 600, "lineHeight": 1.4,  "usage": "Uppercase labels, chips, tags" },
    "caption": { "size": "12px", "weight": 400, "lineHeight": 1.5,  "usage": "Source notes, disclaimer — floor tuyệt đối" }
  },
  "spacing": {
    "pagePadding": "32px",
    "sectionGap":  "24px",
    "cardPad":     "16px"
  },
  "radius": {
    "sheet": "16px",
    "card":  "12px",
    "chip":  "20px",
    "badge": "8px"
  },
  "print": {
    "pageSize":      "A4 portrait",
    "marginMm":      0,
    "widthMm":       210,
    "_note": "Font-size minimum trong @media print: 12px (hard floor). Scale xuống tối đa là body→12px, label→12px, KHÔNG dưới ngưỡng này."
  }
}
